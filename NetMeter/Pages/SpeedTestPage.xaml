<Page x:Class="NetMeter.Pages.SpeedTestPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Speed test">
    <StackPanel Margin="32,8,32,32">
        <TextBlock Text="Speed test" Style="{StaticResource PageTitle}" />

        <ui:Card Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Pulse24" Foreground="{StaticResource PingBrush}" FontSize="16" />
                        <TextBlock Text="  Latency" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock x:Name="PingText" Text="—" Style="{StaticResource BigNumber}" FontSize="36" />
                    <TextBlock Text="ms" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowDownload24" Foreground="{StaticResource DownBrush}" FontSize="16" />
                        <TextBlock Text="  Download" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock x:Name="DownText" Text="—" Style="{StaticResource BigNumber}" FontSize="36" />
                    <TextBlock Text="Mbps" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowUpload24" Foreground="{StaticResource UpBrush}" FontSize="16" />
                        <TextBlock Text="  Upload" Style="{StaticResource Caption}" />
                    </StackPanel>
                    <TextBlock x:Name="UpText" Text="—" Style="{StaticResource BigNumber}" FontSize="36" />
                    <TextBlock Text="Mbps" Style="{StaticResource Caption}" />
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="160">
                    <ui:Button x:Name="StartButton" Content="Start test" Icon="{ui:SymbolIcon Play24}"
                               Appearance="Primary" HorizontalAlignment="Stretch" Padding="16,10" Click="Start_Click" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" Margin="0,8,0,0"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ui:Card>
        <ProgressBar x:Name="Progress" Height="3" Margin="8,0" Maximum="3" Visibility="Hidden" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Uses Cloudflare's speed test servers (speed.cloudflare.com). A test runs about 20 seconds and can use a few hundred MB on a fast connection." />

        <TextBlock Text="History" Style="{StaticResource Section}" />
        <ui:Card Padding="18,10">
            <StackPanel>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="When" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="Download" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="Upload" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="Latency" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="Server" Style="{StaticResource Caption}" />
                </Grid>
                <ItemsControl x:Name="HistoryList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="{Binding Time, StringFormat='{}{0:ddd d MMM, HH:mm}'}" />
                                <TextBlock Grid.Column="1" Text="{Binding DownMbps, StringFormat='{}{0:0.0} Mbps'}" />
                                <TextBlock Grid.Column="2" Text="{Binding UpMbps, StringFormat='{}{0:0.0} Mbps'}" />
                                <TextBlock Grid.Column="3" Text="{Binding PingMs, StringFormat='{}{0:0} ms'}" />
                                <TextBlock Grid.Column="4" Text="{Binding Server}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="No tests yet." Style="{StaticResource Caption}" Margin="0,4" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
