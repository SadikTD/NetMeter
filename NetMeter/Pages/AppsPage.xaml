<Page x:Class="NetMeter.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Apps">
    <StackPanel Margin="32,8,32,32">
        <TextBlock Text="Apps using the internet" Style="{StaticResource PageTitle}" />

        <ui:Card x:Name="AdminCard" Padding="18,16" Margin="0,0,0,12">
            <DockPanel>
                <ui:Button DockPanel.Dock="Right" Content="Restart as administrator" Icon="{ui:SymbolIcon Shield24}"
                           Appearance="Primary" VerticalAlignment="Center" Click="Elevate_Click" />
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Needs administrator rights" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Windows only shares per-app network traffic with administrator programs. To track it from startup too, turn on 'Start as administrator' in Settings after restarting." />
                </StackPanel>
            </DockPanel>
        </ui:Card>
        <TextBlock x:Name="ErrorText" Foreground="#F28B82" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" />

        <ui:Card Padding="18,10">
            <StackPanel>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="App" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="↓ Now" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="↑ Now" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="↓ Total" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="↑ Total" Style="{StaticResource Caption}" />
                </Grid>
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                                    </Style>
                                </Grid.Resources>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{Binding DownNow}" Foreground="{StaticResource DownBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding UpNow}" Foreground="{StaticResource UpBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding DownTotal}" />
                                <TextBlock Grid.Column="4" Text="{Binding UpTotal}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" Margin="0,4" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
