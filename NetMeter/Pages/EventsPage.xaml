<Page x:Class="NetMeter.Pages.EventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Events">
    <StackPanel Margin="32,8,32,32">
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="FilterBox" Width="150" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,0">
                    <ComboBoxItem Content="All events" />
                    <ComboBoxItem Content="Outage" />
                    <ComboBoxItem Content="Ping spike" />
                    <ComboBoxItem Content="Speed test" />
                    <ComboBoxItem Content="Data cap" />
                </ComboBox>
                <ui:Button Content="Export CSV" Icon="{ui:SymbolIcon ArrowDownload24}" Click="Export_Click" Margin="0,0,8,0" />
                <ui:Button Content="Clear" Icon="{ui:SymbolIcon Delete24}" Click="Clear_Click" />
            </StackPanel>
            <TextBlock Text="Events" Style="{StaticResource PageTitle}" />
        </DockPanel>

        <UniformGrid Columns="3" Margin="-6,0,-6,12">
            <ui:Card Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Outages, last 30 days" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="OutageCount" Style="{StaticResource BigNumber}" FontSize="24" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Time offline, last 30 days" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="OutageTime" Style="{StaticResource BigNumber}" FontSize="24" />
                </StackPanel>
            </ui:Card>
            <ui:Card Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="Ping spikes, last 7 days" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="SpikeCount" Style="{StaticResource BigNumber}" FontSize="24" />
                </StackPanel>
            </ui:Card>
        </UniformGrid>

        <ui:Card Padding="18,10">
            <StackPanel>
                <ItemsControl x:Name="EventList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time, StringFormat='{}{0:ddd d MMM, HH:mm:ss}'}" Style="{StaticResource Caption}" FontSize="13" />
                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding DurationText}" TextAlignment="Right"
                                           Style="{StaticResource Caption}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Style="{StaticResource Caption}" Margin="0,4" TextWrapping="Wrap"
                           Text="Nothing yet. Outages, ping spikes, speed tests and data limit warnings show up here." />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
