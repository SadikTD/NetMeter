<Page x:Class="NetMeter.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:NetMeter"
      Title="Settings">
    <Page.Resources>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="32,8,32,32" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />

        <ui:CardAction Icon="{ui:SymbolIcon PaintBrush24}" Click="Widget_Click" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="Taskbar widget" Style="{StaticResource RowTitle}" />
                <TextBlock Text="Style, font, size, weight, icons, units, colors and what it shows." Style="{StaticResource RowHint}" />
            </StackPanel>
        </ui:CardAction>

        <!-- Measurement -->
        <TextBlock Text="Measurement" Style="{StaticResource Section}" Margin="0,12,0,8" />
        <ui:CardControl Icon="{ui:SymbolIcon Timer24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Update every (seconds)" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="0.5 to 5 seconds." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox Value="{local:Set IntervalSec}" Minimum="0.5" Maximum="5" SmallChange="0.5" MaxDecimalPlaces="1" Width="130" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Smooth numbers" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Averages out jumps so the readout is calmer." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{local:Set Smooth}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Network adapter" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Pick one if a VPN or virtual adapter makes numbers look doubled." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="AdapterBox" Width="300" DisplayMemberPath="Key" SelectedValuePath="Value"
                      SelectedValue="{local:Set Adapter}" />
        </ui:CardControl>

        <!-- Ping and alerts -->
        <TextBlock Text="Ping and alerts" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon Pulse24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Ping host" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="1.1.1.1 (Cloudflare), 8.8.8.8 (Google) or a game server like 151.106.246.1 (Riot Mumbai)." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox Text="{local:Set PingHost}" Width="200" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Header>
                <TextBlock Text="Ping every (seconds)" Style="{StaticResource RowTitle}" />
            </ui:CardControl.Header>
            <ui:NumberBox Value="{local:Set PingIntervalSec}" Minimum="1" Maximum="60" SmallChange="1" MaxDecimalPlaces="0" Width="130" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="High ping alert" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Notify when 3 pings in a row are above this many ms (at most every 5 minutes)." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:NumberBox Value="{local:Set PingAlertMs}" Minimum="10" Maximum="2000" SmallChange="10" MaxDecimalPlaces="0" Width="130" Margin="0,0,12,0" />
                <ui:ToggleSwitch IsChecked="{local:Set PingAlerts}" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Internet down alerts" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Notify when the connection drops and when it comes back, with how long it was down." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{local:Set OutageAlerts}" />
        </ui:CardControl>

        <!-- Data limit -->
        <TextBlock Text="Monthly data limit" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon DataUsage24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Limit (GB)" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="0 turns it off. You get a notification at 80% and 100%." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox Value="{local:Set CapGB}" Minimum="0" Maximum="100000" SmallChange="10" MaxDecimalPlaces="1" Width="130" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Header>
                <TextBlock Text="Resets on day of month" Style="{StaticResource RowTitle}" />
            </ui:CardControl.Header>
            <ui:NumberBox Value="{local:Set CapResetDay}" Minimum="1" Maximum="31" SmallChange="1" MaxDecimalPlaces="0" Width="130" />
        </ui:CardControl>

        <!-- App -->
        <TextBlock Text="App" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon PaintBrush24}">
            <ui:CardControl.Header>
                <TextBlock Text="Dashboard theme" Style="{StaticResource RowTitle}" />
            </ui:CardControl.Header>
            <ComboBox Width="160" SelectedValue="{local:Set Theme}" SelectedValuePath="Tag">
                <ComboBoxItem Content="Match Windows" Tag="System" />
                <ComboBoxItem Content="Light" Tag="Light" />
                <ComboBoxItem Content="Dark" Tag="Dark" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Play24}">
            <ui:CardControl.Header>
                <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{local:Set StartWithWindows}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Shield24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Start as administrator" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="ElevatedHint" Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ElevatedToggle" IsChecked="{local:Set StartElevated}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Show tray icon" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Notifications still appear when it's hidden." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{local:Set TrayIcon}" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Keyboard24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Show / hide hotkey" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Click the box and press a shortcut, such as Ctrl+Alt+N. Backspace clears it." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:TextBox x:Name="HotkeyBox" Width="180" IsReadOnly="True" PreviewKeyDown="Hotkey_KeyDown" IsReadOnlyCaretVisible="False" />
        </ui:CardControl>

        <!-- Updates -->
        <TextBlock Text="Updates and about" Style="{StaticResource Section}" />
        <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="UpdateText" Text="Checks GitHub once a day." Style="{StaticResource RowHint}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="InstallButton" Content="Install update" Appearance="Primary" Margin="0,0,8,0"
                           Visibility="Collapsed" Click="Install_Click" />
                <ui:Button x:Name="CheckButton" Content="Check now" Margin="0,0,12,0" Click="Check_Click" />
                <ui:ToggleSwitch IsChecked="{local:Set AutoUpdate}" ToolTip="Check automatically" />
            </StackPanel>
        </ui:CardControl>
        <ui:Card Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="GitHub page" Icon="{ui:SymbolIcon Globe24}" Click="GitHub_Click" Margin="0,0,8,0" />
                <ui:Button Content="Open data folder" Icon="{ui:SymbolIcon Info24}" Click="DataFolder_Click" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
