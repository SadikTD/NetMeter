<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\NetMeter.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>NetMeter</Product>
    <Company>SadikTD</Company>
    <Description>Internet speed meter for the Windows taskbar</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WPF owns DPI awareness through app.manifest; WinForms is only used for the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\NetMeter.ico" />
  </ItemGroup>

</Project>
